<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LongPress</AssemblyName>
    <RootNamespace>LongPress</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.1</Version>
    <ApplicationIcon>assets\LongPress.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Tray icons (TrayApp loads them by these names). -->
    <EmbeddedResource Include="assets\LongPress.ico" LogicalName="LongPress.ico" />
    <EmbeddedResource Include="assets\LongPress-paused.ico" LogicalName="LongPress-paused.ico" />
  </ItemGroup>

  <!-- Release publishes a self-contained single exe (no .NET runtime needed) into publish\.
       No trimming: WinForms doesn't support it. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\publish\</PublishDir>
  </PropertyGroup>

</Project>
